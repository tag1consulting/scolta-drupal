<?php

/**
 * @file
 * Scolta module hooks.
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\Core\StringTranslation\TranslatableMarkup;
use Drupal\Core\Url;
use Drupal\scolta\Plugin\QueueWorker\ScoltaRebuildWorker;
use Tag1\Scolta\Index\RetiredIndexTrash;
use Tag1\Scolta\Storage\FilesystemDriver;

/**
 * Format of the build state (ledger, manifest keys) the current code writes.
 *
 * Bump it, and add an update hook calling scolta_reset_index_state(),
 * whenever a release writes state an earlier release's ledger or manifest
 * cannot share.
 */
// phpcs:ignore DrupalPractice.Constants.GlobalConstant.GlobalConstant
const SCOLTA_STATE_FORMAT = 10007;

/**
 * Record the state format in the build state directory, if not already there.
 *
 * The marker lives beside the state it describes, so a database rollback or a
 * copied-in production database does not make scolta_reset_index_state()
 * discard state that is already in the new format.
 *
 * @param string $stateDir
 *   The build state directory, a path or stream-wrapper URI, which must exist.
 *
 * @since 1.4.1
 * @stability experimental
 */
function scolta_mark_state_format(string $stateDir): void {
  $marker = rtrim($stateDir, '/') . '/state-format';
  if (is_dir($stateDir) && (!is_file($marker) || (int) file_get_contents($marker) < SCOLTA_STATE_FORMAT)) {
    file_put_contents($marker, (string) SCOLTA_STATE_FORMAT);
  }
}

/**
 * Implements hook_help().
 */
function scolta_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.scolta':
      // The Site Type preset lives on scolta_ui's settings form, so the help
      // for that route is scolta_ui's to answer; this is the backend's own
      // help page, which still has to point at the setting.
      return '<p>' . t('Getting fewer search results than you expect on a recipe, product, or catalog site? Open the <strong>Site Type</strong> section of the Scolta search settings and choose the <em>Recipe &amp; Content Catalog</em> preset, then rebuild the index. See the module README ("Tuning search breadth") for the full guide.') . '</p>';
  }
}

/**
 * Implements hook_cron().
 *
 * Time-boxed deletion of retired index directories (`.scolta-trash-*`).
 * Publishing a new index renames the previous one to trash and returns;
 * it does not delete it (see RetiredIndexTrash in scolta-php). Deleting is
 * this cron sweep's job, with a 60 s sweep at the start of the next build
 * as the backstop for a site with no cron. `drush scolta:cleanup` remains
 * for on-demand or unbounded runs.
 *
 * The budget comes from cleanup.cron_seconds (0 disables cron cleanup, 180
 * when unset). On web-triggered cron the budget is additionally capped by
 * the request's remaining max_execution_time, minus a margin for the other
 * hook_cron implementations queued behind this one — an interrupted sweep is
 * harmless (it resumes next run), but killing the whole cron request is not.
 */
function scolta_cron(): void {
  $config = \Drupal::config('scolta.settings');
  $budget = (float) ($config->get('cleanup.cron_seconds') ?? 180);
  if ($budget <= 0) {
    return;
  }

  $limit = (int) ini_get('max_execution_time');
  if ($limit > 0) {
    $elapsed = microtime(TRUE) - (float) ($_SERVER['REQUEST_TIME_FLOAT'] ?? microtime(TRUE));
    $remaining = $limit - $elapsed - 10.0;
    if ($remaining <= 1.0) {
      return;
    }
    $budget = min($budget, $remaining);
  }

  $output_dir = $config->get('pagefind.output_dir') ?? 'public://scolta-pagefind';
  if (str_contains($output_dir, '://')) {
    try {
      $wrapper = \Drupal::service('stream_wrapper_manager')->getViaUri($output_dir);
      $resolved = $wrapper ? $wrapper->realpath() : FALSE;
    }
    catch (\Throwable $e) {
      \Drupal::logger('scolta')->warning('Cron cleanup could not resolve pagefind.output_dir (@dir): @message', [
        '@dir' => $output_dir,
        '@message' => $e->getMessage(),
      ]);
      return;
    }
    if (!$resolved) {
      \Drupal::logger('scolta')->warning('Cron cleanup could not resolve pagefind.output_dir (@dir) to a real path; skipping this run.', [
        '@dir' => $output_dir,
      ]);
      return;
    }
    $output_dir = $resolved;
  }
  $output_dir = rtrim($output_dir, '/');
  // The orchestrator publishes to <output_dir>/pagefind and normalizes a
  // config value that already carries the suffix; trash sits beside the
  // published directory, so mirror that normalization here.
  if (str_ends_with($output_dir, '/pagefind')) {
    $output_dir = substr($output_dir, 0, -strlen('/pagefind'));
  }

  $trash = new RetiredIndexTrash(new FilesystemDriver(), $output_dir);
  if ($trash->trashDirs() === []) {
    return;
  }
  $trash->sweep(\Drupal::logger('scolta'), $budget);
}

/**
 * Implements hook_entity_insert().
 */
function scolta_entity_insert(EntityInterface $entity) {
  _scolta_auto_rebuild_check($entity, 'insert');
}

/**
 * Implements hook_entity_update().
 */
function scolta_entity_update(EntityInterface $entity) {
  _scolta_auto_rebuild_check($entity, 'update');
}

/**
 * Implements hook_entity_delete().
 *
 * Without this the index keeps serving a deleted node until some unrelated
 * save triggers a rebuild, or an operator runs a full one by hand. The
 * incremental update path tombstones a removed page, so a delete now has a
 * trigger that costs the same as an edit.
 */
function scolta_entity_delete(EntityInterface $entity) {
  _scolta_auto_rebuild_check($entity, 'delete');
}

/**
 * Implements hook_page_top().
 *
 * Renders Scolta's persistent admin notices on every admin page load:
 *  - the index rebuild notice, with per-user dismissal.
 *
 * The Amazee.ai re-authentication prompt is the frontend's, and lives in
 * scolta_ui: the credentials it is about belong to the AI tier.
 */
function scolta_page_top(array &$page_top) {
  // Only show to users with admin access on admin routes.
  $current_user = \Drupal::currentUser();
  if (!$current_user->hasPermission('administer scolta')) {
    return;
  }

  /** @var \Drupal\Core\Routing\AdminContext $admin_context */
  $admin_context = \Drupal::service('router.admin_context');
  if (!$admin_context->isAdminRoute()) {
    return;
  }

  _scolta_rebuild_notice($page_top, $current_user);
}

/**
 * Render the persistent index rebuild notice with per-user dismissal.
 *
 * Shows until the admin explicitly dismisses it or a new rebuild replaces it.
 *
 * @param array $page_top
 *   The page_top render array, modified by reference.
 * @param \Drupal\Core\Session\AccountInterface $current_user
 *   The current user (already checked for the 'administer scolta' permission).
 */
function _scolta_rebuild_notice(array &$page_top, AccountInterface $current_user): void {
  $notice = \Drupal::state()->get('scolta.rebuild_notice');
  if (!$notice || empty($notice['notice_id'])) {
    return;
  }

  $notice_id = $notice['notice_id'];

  // Per-user dismissal check.
  /** @var \Drupal\user\UserDataInterface $user_data */
  $user_data = \Drupal::service('user.data');
  $dismissed = $user_data->get('scolta', $current_user->id(), 'dismissed_rebuild_notice');
  if ($dismissed === $notice_id) {
    return;
  }

  $result = $notice['result'] ?? 'ok';
  $message = $notice['message'] ?? '';

  $type = $result === 'ok' ? 'status' : 'error';
  $text = $result === 'ok'
    ? t('Scolta index rebuilt: @msg', ['@msg' => $message])
    : t('Scolta index rebuild failed.');

  // The dismiss route requires a CSRF token. Render the link through
  // '#type' => 'link' so the token placeholder the route processor emits
  // is replaced during rendering — a hand-stringified URL would carry the
  // raw placeholder and always fail validation.
  $page_top['scolta_rebuild_notice'] = [
    '#type' => 'container',
    '#attributes' => [
      'role' => 'contentinfo',
      'class' => ['messages', 'messages--' . $type],
    ],
    '#weight' => -100,
    // The notice depends on per-user dismissal state and the transient
    // rebuild-notice state key, both read at render time — never cache it.
    '#cache' => ['max-age' => 0],
    'content' => [
      '#type' => 'container',
      '#attributes' => ['class' => ['messages__content']],
      'text' => [
        '#plain_text' => $text,
        '#suffix' => ' ',
      ],
      'dismiss' => [
        '#type' => 'link',
        '#title' => t('Dismiss'),
        '#url' => Url::fromRoute('scolta.dismiss_rebuild_notice', [], [
          'query' => [
            'notice_id'   => $notice_id,
            'destination' => \Drupal::service('path.current')->getPath(),
          ],
        ]),
      ],
    ],
  ];
}

/**
 * @defgroup scolta_hooks Scolta module hooks
 * @{
 * Hooks for extending Scolta content gathering and indexing.
 *
 * @see scolta.api.php
 * @}
 */

/**
 * Check if auto-rebuild should be triggered for the given entity.
 *
 * Enqueues a rebuild request when an entity of an indexed type and bundle
 * (scolta.settings: entity_types) is inserted, updated or deleted and
 * pagefind.auto_rebuild is on.
 *
 * The queue item carries the identity of what changed: the entity ID and the
 * per-translation content item IDs the gatherer would produce for it. Without
 * them the worker only knows that "something" changed and has to walk the
 * whole corpus to find out what, which on a six-figure site is the entire
 * build. With them it gathers exactly the changed entities and drives the
 * incremental index update path.
 *
 * @param \Drupal\Core\Entity\EntityInterface $entity
 *   The entity that was inserted, updated or deleted.
 * @param string $op
 *   The operation: 'insert', 'update' or 'delete'.
 */
function _scolta_auto_rebuild_check(EntityInterface $entity, $op = 'update') {
  $config = \Drupal::config('scolta.settings');
  if (!$config->get('pagefind.auto_rebuild')) {
    return;
  }
  if (!\Drupal::service('scolta.content_gatherer')->isIndexable($entity)) {
    return;
  }

  // The item IDs must be derived by the gatherer: it owns the rule that maps
  // an entity plus a langcode onto an indexed page ID ('42', '42-es'), and
  // that ID is the key the page-table ledger stores, so a second copy of the
  // rule here would silently orphan pages the moment the two drifted.
  $itemIds = [];
  try {
    $gatherer = \Drupal::service('scolta.content_gatherer');
    $itemIds = $gatherer->itemIdsFor($entity);

    // An update that removed a translation leaves that translation's page with
    // no trigger at all: it is gone from the entity's current translation list,
    // so it never reaches the payload, and the worker only tombstones IDs it
    // expected but did not gather. Union the pre-save IDs so a removed
    // translation is expected, is not produced, and is therefore removed.
    if ($op === 'update') {
      $original = method_exists($entity, 'getOriginal')
        ? $entity->getOriginal()
        : ($entity->original ?? NULL);
      if ($original instanceof EntityInterface) {
        $itemIds = array_values(array_unique(array_merge($itemIds, $gatherer->itemIdsFor($original))));
      }
    }
  }
  catch (\Throwable $e) {
    // A malformed entity must not block the save. An empty item ID list makes
    // the worker treat this as an untargeted change and fall back to a full
    // rebuild, which is correct but slow — never wrong.
    \Drupal::logger('scolta')->warning('Could not derive Scolta item IDs for @type @id: @message', [
      '@type' => $entity->getEntityTypeId(),
      '@id' => $entity->id(),
      '@message' => $e->getMessage(),
    ]);
  }

  $now = \Drupal::time()->getCurrentTime();
  \Drupal::state()->set('scolta.rebuild_requested_at', $now);
  // The oldest unserved request caps how long the worker's debounce may hold
  // a build off; only the first change after a build opens that window.
  if (!\Drupal::state()->get(ScoltaRebuildWorker::FIRST_REQUEST_KEY)) {
    \Drupal::state()->set(ScoltaRebuildWorker::FIRST_REQUEST_KEY, $now);
  }
  \Drupal::queue('scolta_rebuild')->createItem([
    'type' => 'auto',
    'op' => $op,
    'entity_type' => $entity->getEntityTypeId(),
    'entity_id' => $entity->id(),
    'item_ids' => $itemIds,
  ]);
}

/**
 * Queue a full index rebuild, optionally one that reloads every entity.
 *
 * For update hooks in consuming sites, hook_update_N() and
 * hook_post_update_NAME() alike. Use this when indexed output went stale
 * because the code that produces it changed rather than the content: an
 * edited hook_scolta_content_item_alter(), a new field mapping, a changed
 * body_fields setting. Use scolta_reset_index_state() only when a scolta
 * release changed the ledger or manifest format; it empties the whole state
 * directory, renumbers every page from zero, and its state-format marker
 * makes it a no-op between format bumps.
 *
 * A queued full rebuild without $force reuses the manifest record of every
 * entity whose changed timestamp is unchanged, metadata included, so it is
 * mostly skipped when the manifest is current. With $force the build reloads
 * every entity, as `drush scolta:build --force` does; items whose content
 * did not change still reuse their cached tokens. The flag rides on the
 * queue item and the worker acts on it under the build lock, so a build
 * already running when the hook fires is left alone and the next one is
 * forced; nothing in the state directory is touched here.
 *
 * @param string $reason
 *   Recorded on the queue item, e.g. __FUNCTION__ of the update hook.
 * @param bool $force
 *   Reload every entity instead of serving manifest-cached fragments.
 *
 * @return \Drupal\Core\StringTranslation\TranslatableMarkup
 *   What happened, for an update hook to return.
 *
 * @since 2.0.0
 * @stability stable
 */
function scolta_queue_full_rebuild(string $reason, bool $force = FALSE): TranslatableMarkup {
  // A payload naming no item IDs is untargeted: the worker folds it into a
  // full build, forced when any folded request is; see
  // ScoltaRebuildWorker::foldPayload().
  \Drupal::queue('scolta_rebuild')->createItem(['type' => $reason, 'force' => $force]);

  return $force
    ? t('A full rebuild that reloads every entity is queued for the next `drush queue:run scolta_rebuild` tick; sites without that cron line should run `drush scolta:build --force` now.')
    : t('A full rebuild is queued for the next `drush queue:run scolta_rebuild` tick; sites without that cron line should run `drush scolta:build` now.');
}
