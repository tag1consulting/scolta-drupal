<?xml version="1.0"?>
<ruleset name="Scolta Drupal">
  <description>Drupal coding standards for Scolta module</description>
  <arg name="extensions" value="php,module,install,inc,theme"/>
  <arg name="colors"/>
  <arg value="sp"/>

  <file>src</file>
  <file>scolta.module</file>
  <file>scolta.install</file>
  <!-- The scolta_ui module ships from this package and is held to the
       same standard; its own tests are excluded by the pattern below. -->
  <file>modules</file>

  <!--
    Tests are out of scope. The <file> list above already says so when phpcs is
    invoked bare, but a path argument on the command line overrides it, and
    `ddev phpcs` always passes one (web/modules/custom/<project>). Stating the
    exclusion as a pattern makes it hold either way.
  -->
  <exclude-pattern>tests/</exclude-pattern>

  <rule ref="Drupal"/>
  <rule ref="DrupalPractice"/>

  <!-- Allow long lines in tests -->
  <rule ref="Drupal.Files.LineLength">
    <exclude-pattern>tests/*</exclude-pattern>
  </rule>
</ruleset>
