{
    "name": "tag1/scolta-drupal",
    "description": "Scolta AI Search for Drupal \u2014 Search API backend with Pagefind client-side search",
    "type": "drupal-module",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Tag1 Consulting",
            "homepage": "https://www.tag1.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "drupal/search_api": "^1.0",
        "tag1/scolta-php": "^1.3.0",
        "composer/installers": "^2"
    },
    "suggest": {
        "drupal/ai": "For enhanced multi-provider AI support via the Drupal AI Initiative module (48+ providers, Key module integration, rate limiting, token tracking)"
    },
    "require-dev": {
        "drupal/coder": "^8.3.30 || ^9.0",
        "drush/drush": "^13",
        "mglaman/phpstan-drupal": "^2.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpunit/phpunit": "^10.0|^11.0",
        "symfony/yaml": "^6.0|^7.0"
    },
    "scripts": {
        "analyse": "phpstan analyse --no-progress",
        "test": "phpunit",
        "lint": "phpcs",
        "format": "phpcbf",
        "validate-release": "php scripts/validate-release.php"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "path",
            "url": "../scolta-php",
            "canonical": false
        }
    ],
    "autoload": {
        "psr-4": {
            "Drupal\\scolta\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Drupal\\scolta\\Tests\\": "tests/src/"
        }
    },
    "extra": {
        "installer-paths": {
            "web/core": ["type:drupal-core"],
            "web/modules/contrib/{$name}": ["type:drupal-module"],
            "web/themes/contrib/{$name}": ["type:drupal-theme"],
            "web/libraries/{$name}": ["type:drupal-library"]
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            },
            "file-mapping": {
                "[project-root]/.gitattributes": false,
                "[project-root]/.editorconfig": false,
                "[project-root]/recipes/README.txt": false
            }
        },
        "phpstan/extension-installer": {
            "ignore": [
                "phpstan/phpstan-deprecation-rules"
            ]
        },
        "installer-name": "scolta",
        "branch-alias": {
            "dev-main": "1.4.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "symfony/runtime": true
        },
        "audit": {
            "ignore": [
                "PKSA-5jz8-6tcw-pbk4",
                "PKSA-z3gr-8qht-p93v"
            ]
        }
    }
}
