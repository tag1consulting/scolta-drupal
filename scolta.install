<?php

/**
 * @file
 * Install and uninstall hooks for the Scolta module.
 */

use Tag1\Scolta\Binary\PagefindBinary;
use Composer\InstalledVersions;
use Drupal\Core\Site\Settings;
use Drupal\scolta\Form\ScoltaSettingsForm;
use Tag1\Scolta\AiProvider\Amazee\AutoProvisioner;
use Drupal\Core\File\FileExists;
use Drupal\user\Entity\Role;
use Drupal\user\RoleInterface;

/**
 * Implements hook_install().
 */
function scolta_install() {
  _scolta_deploy_assets();

  // Attempt Amazee.ai auto-provisioning so search AI works out of the box.
  _scolta_auto_provision_amazee();

  // Grant 'use scolta ai' to anonymous and authenticated by default so that
  // visitors can reach AI overviews, expansion, and follow-up out of the box.
  // Site admins can revoke this at Administration › People › Permissions to
  // restrict AI features to specific roles.
  user_role_grant_permissions(RoleInterface::ANONYMOUS_ID, ['use scolta ai']);
  user_role_grant_permissions(RoleInterface::AUTHENTICATED_ID, ['use scolta ai']);

  \Drupal::queue('scolta_rebuild')->createItem(['type' => 'install']);
  \Drupal::messenger()->addStatus(t('Scolta installed. Your search index will be built on the next cron run. To build immediately: <code>drush scolta:build</code>'));
}

/**
 * Attempt Amazee.ai trial provisioning at module install time.
 *
 * No-op when the user has an explicit API key configured, or when
 * credentials are already stored. Failures are silenced — the install
 * succeeds regardless.
 */
function _scolta_auto_provision_amazee(): void {
  /** @var \Tag1\Scolta\AiProvider\Amazee\ConfigStorageInterface $storage */
  $storage = \Drupal::service('scolta.amazee_config_storage');

  AutoProvisioner::ensureAiAvailable(
    $storage,
    hasExplicitApiKey: _scolta_has_explicit_api_key(),
  );
}

/**
 * Check whether the site has an explicit Scolta API key configured.
 *
 * Returns TRUE when SCOLTA_API_KEY env var, scolta.api_key in settings.php,
 * or scolta.settings ai_api_key in Drupal config is non-empty, meaning the
 * user has their own provider and auto-provisioning should be skipped.
 */
function _scolta_has_explicit_api_key(): bool {
  $envKey = getenv('SCOLTA_API_KEY');
  if ($envKey !== FALSE && $envKey !== '') {
    return TRUE;
  }

  $settingsKey = Settings::get('scolta.api_key', '');
  if (!empty($settingsKey)) {
    return TRUE;
  }

  // Drupal config-stored key (e.g. set via config import or admin UI path).
  $configKey = \Drupal::config('scolta.settings')->get('ai_api_key') ?? '';
  return $configKey !== '';
}

/**
 * Deploy compiled JS/CSS/WASM assets from scolta-php into the module directory.
 *
 * Composer only runs post-install-cmd scripts for the root package, so assets
 * are never copied during `composer require`. This hook does the copy at
 * Drupal module install time instead.
 */
function _scolta_deploy_assets(): void {
  // Locate scolta-php via Composer's installed package registry.
  $scoltaPhpPath = NULL;
  if (class_exists(InstalledVersions::class)) {
    try {
      $scoltaPhpPath = InstalledVersions::getInstallPath('tag1/scolta-php');
    }
    catch (\OutOfBoundsException $e) {
      // Package not registered; fall through to fallback.
    }
  }
  if (!$scoltaPhpPath) {
    // Fallback: standard Composer vendor location relative to Drupal root.
    $scoltaPhpPath = \Drupal::root() . '/../vendor/tag1/scolta-php';
  }

  $assetsDir = rtrim((string) $scoltaPhpPath, '/') . '/assets';
  if (!is_dir($assetsDir)) {
    \Drupal::logger('scolta')->warning('scolta-php assets not found at @path — JS/CSS/WASM unavailable.', ['@path' => $assetsDir]);
    return;
  }

  $modulePath = \Drupal::root() . '/' . \Drupal::service('extension.list.module')->getPath('scolta');

  // Map: source path (relative to assets/) => dest path (relative to module).
  $assets = [
    'js/scolta.js' => 'js/scolta.js',
    'css/scolta.css' => 'css/scolta.css',
    'wasm/scolta_core.js' => 'js/wasm/scolta_core.js',
    'wasm/scolta_core_bg.wasm' => 'js/wasm/scolta_core_bg.wasm',
  ];

  $fileSystem = \Drupal::service('file_system');

  foreach ($assets as $src => $dest) {
    $srcPath = $assetsDir . '/' . $src;
    $destPath = $modulePath . '/' . $dest;
    if (!file_exists($srcPath)) {
      \Drupal::logger('scolta')->warning('Missing scolta-php asset: @path', ['@path' => $srcPath]);
      continue;
    }
    $destDir = dirname($destPath);
    if (!is_dir($destDir)) {
      $fileSystem->mkdir($destDir, 0755, TRUE);
    }
    $fileSystem->copy($srcPath, $destPath, FileExists::Replace);
  }
}

/**
 * Implements hook_requirements().
 */
function scolta_requirements(string $phase): array {
  $requirements = [];

  if ($phase === 'runtime') {
    $config = \Drupal::config('scolta.settings');
    $indexer = $config->get('indexer') ?? 'auto';

    if ($indexer === 'binary') {
      // Only check binary availability when explicitly configured to use it.
      $binary_path = $config->get('pagefind.binary') ?? 'pagefind';
      $resolver = new PagefindBinary(
        configuredPath: $binary_path !== 'pagefind' ? $binary_path : NULL,
        projectDir: \Drupal::root(),
      );
      $status = $resolver->status();

      if (!$status['available']) {
        $requirements['scolta_pagefind_binary'] = [
          'title' => t('Scolta Search Indexer'),
          'value' => t('Pagefind binary (not found)'),
          'description' => t('Indexer is set to "binary" but the Pagefind binary was not found. Install Pagefind (<code>npm install -g pagefind</code>) or change indexer to "auto" in Scolta settings.'),
          'severity' => REQUIREMENT_ERROR,
        ];
      }
      else {
        $requirements['scolta_pagefind_binary'] = [
          'title' => t('Scolta Search Indexer'),
          'value' => t('Pagefind binary (@version)', ['@version' => $status['version'] ?? 'unknown']),
          'severity' => REQUIREMENT_OK,
        ];
      }
    }
    else {
      // Auto or php: PHP indexer is active, no binary needed.
      $requirements['scolta_pagefind_binary'] = [
        'title' => t('Scolta Search Indexer'),
        'value' => t('PHP indexer (active)'),
        'severity' => REQUIREMENT_OK,
      ];
    }
  }

  return $requirements;
}

/**
 * Implements hook_uninstall().
 */
function scolta_uninstall() {
  // Remove deployed assets from the module directory.
  $modulePath = \Drupal::root() . '/' . \Drupal::service('extension.list.module')->getPath('scolta');
  $fileSystem = \Drupal::service('file_system');
  $deployed = [
    'js/scolta.js',
    'css/scolta.css',
    'js/wasm/scolta_core.js',
    'js/wasm/scolta_core_bg.wasm',
  ];
  foreach ($deployed as $asset) {
    $path = $modulePath . '/' . $asset;
    if (file_exists($path)) {
      $fileSystem->delete($path);
    }
  }
  $wasmDir = $modulePath . '/js/wasm';
  // phpcs:ignore Drupal.Functions.DiscouragedFunctions -- scandir() used for a simple emptiness check; scanDirectory() returns objects and is heavier for this purpose.
  if (is_dir($wasmDir) && count(array_diff(scandir($wasmDir), ['.', '..'])) === 0) {
    $fileSystem->rmdir($wasmDir);
  }

  // Clean up the rebuild queue.
  \Drupal::queue('scolta_rebuild')->deleteQueue();

  // Release the build lock if possible.
  if (!\Drupal::lock()->lockMayBeAvailable('scolta_build')) {
    \Drupal::lock()->release('scolta_build');
  }

  // Clean up state entries.
  \Drupal::state()->delete('scolta.rebuild_requested_at');
  \Drupal::state()->delete('scolta.generation');
  \Drupal::state()->delete('scolta.rebuild_notice');
  \Drupal::state()->delete('scolta.amazee.credentials');
  \Drupal::state()->delete('scolta.amazee.budget_notice_time');

  // Clean up per-user data (e.g. dismissed rebuild notices).
  \Drupal::service('user.data')->delete('scolta');
}

/**
 * Grants 'use scolta ai' to the anonymous and authenticated roles.
 *
 * Backfills onto existing sites the grant that scolta_install() applies to
 * fresh installs. Without it the fix ships in name only: the changelog says
 * anonymous visitors get AI overviews, an already-installed site keeps the
 * restrictive default it was installed with, and every anonymous request to
 * /api/scolta/v1/* keeps returning 403 with nothing in the UI explaining why.
 *
 * This is the module's first update hook, so every site installed before it
 * existed sits at the default schema version and runs it. A site installed
 * afterwards records 10001 at install time and skips it, having already been
 * granted the permission by scolta_install() — the grant never happens twice.
 *
 * The per-role guard keeps the function a no-op where the permission is
 * already held: no config write, so no needless cache invalidation, and
 * calling it a second time changes nothing. Sites that deliberately revoke
 * the permission afterwards are unaffected, because an update hook that has
 * run does not run again.
 */
function scolta_update_10001() {
  $granted = [];

  foreach ([RoleInterface::ANONYMOUS_ID, RoleInterface::AUTHENTICATED_ID] as $role_id) {
    $role = Role::load($role_id);
    // A site can have removed either role; nothing to backfill if so.
    if (!$role || $role->hasPermission('use scolta ai')) {
      continue;
    }
    $role->grantPermission('use scolta ai');
    $role->save();
    $granted[] = $role_id;
  }

  if (!$granted) {
    return t('The "use scolta ai" permission was already in place; no roles changed.');
  }

  return t('Granted the "use scolta ai" permission to: @roles. Revoke it at Administration › People › Permissions to restrict AI features to specific roles.', [
    '@roles' => implode(', ', $granted),
  ]);
}

/**
 * Adds the search-as-you-type defaults to existing sites.
 *
 * The install defaults in config/install/scolta.settings.yml only ever apply to
 * a fresh install, so an existing site updating into this release has none of
 * the ten SAYT keys. The browser bundle falls back to its own hardcoded
 * defaults for an absent key, and those match the shipped ones — so the
 * feature would appear to work while the settings form showed values that were
 * nowhere in config, and a site that saved the form would suddenly be writing
 * keys that had never existed. This makes the config state explicit instead.
 *
 * Only absent keys are written. A site that set any of them ahead of the
 * update (drush config:set, a config import, settings.php) keeps its value,
 * including a deliberate FALSE: the guard tests for an absent key, not for a
 * falsy one.
 */
function scolta_update_10002() {
  $defaults = [
    'sayt_enabled' => TRUE,
    'sayt_min_chars' => 2,
    'sayt_debounce_ms' => 150,
    'sayt_max_suggestions' => 6,
    'sayt_recent_searches' => TRUE,
    'sayt_max_recent' => 3,
    'sayt_expand' => TRUE,
    'sayt_expand_per_minute' => 6,
    'sayt_expansion_delay_ms' => 500,
    'sayt_suggestion_action' => 'navigate',
  ];

  $config = \Drupal::configFactory()->getEditable('scolta.settings');
  $added = [];
  foreach ($defaults as $key => $value) {
    if ($config->get($key) === NULL) {
      $config->set($key, $value);
      $added[] = $key;
    }
  }

  if (!$added) {
    return t('Search as you type was already configured; no settings changed.');
  }

  $config->save();

  return t('Search as you type is on by default. Added @count setting(s) to scolta.settings: @keys. Adjust them at Administration › Configuration › Search and metadata › Scolta, under "Search as you type". No index rebuild is needed.', [
    '@count' => count($added),
    '@keys' => implode(', ', $added),
  ]);
}

/**
 * Moves an Amazee.ai gateway model alias out of the operator-facing ai_model.
 *
 * Until this release, Amazee model resolution wrote the LiteLLM gateway's model
 * alias (e.g. claude-4-5-sonnet) straight into scolta.settings ai_model — the
 * same key an administrator uses to name a provider-native model. That alias is
 * only valid against the Amazee gateway, so a site that later switched
 * ai_provider to anthropic, or whose trial expired, kept sending a name the
 * provider's API does not recognise and AI failed with a generic ai_error.
 * Gateway aliases now live in amazee_model / amazee_expansion_model, read only
 * while Amazee credentials are the effective key.
 *
 * The migration is scoped to sites that actually have stored Amazee
 * credentials, because only there could the old callback have written. A site
 * with no credentials is left completely alone: its ai_model may well be an
 * explicit administrator choice, and there is no way after the fact to tell one
 * from an orphaned alias, so guessing would recreate the very bug this fixes.
 * Those sites are covered instead by the provider/model mismatch check in the
 * AI client (tag1consulting/scolta-php#251).
 *
 * On a credentialed site the whole non-default value is treated as
 * gateway-resolved rather than sniffed for alias shape: the old callback wrote
 * unconditionally, so nothing an administrator chose could have survived there
 * anyway, and no alias naming convention is stable enough to test — the names
 * come from whatever the gateway's /model/info returns. Nothing is discarded:
 * the value moves to amazee_model, which is exactly where the gateway path now
 * reads it from, and both values are logged.
 *
 * Idempotent twice over: an update hook that has run does not run again, and
 * the guard skips any site that already has amazee_model set.
 */
function scolta_update_10003() {
  $config = \Drupal::configFactory()->getEditable('scolta.settings');

  // Backfill the keys themselves for every site — config/install only ever
  // applies to a fresh install, and the settings form must not save a key the
  // schema declares but config has never held.
  $backfilled = FALSE;
  foreach (['amazee_model', 'amazee_expansion_model'] as $key) {
    if ($config->get($key) === NULL) {
      $config->set($key, '');
      $backfilled = TRUE;
    }
  }

  $credentials = \Drupal::state()->get('scolta.amazee.credentials');
  $hasCredentials = is_array($credentials) && !empty($credentials['litellm_token']);
  $strandedModel = $config->get('ai_model') ?? '';
  $needsMigration = $hasCredentials
    && ($config->get('amazee_model') ?? '') === ''
    && $strandedModel !== ''
    && $strandedModel !== ScoltaSettingsForm::DEFAULT_AI_MODEL;

  if (!$needsMigration) {
    if ($backfilled) {
      $config->save();
      return t('Added the amazee_model and amazee_expansion_model settings. No Amazee.ai model alias needed moving out of ai_model.');
    }
    return t('No Amazee.ai model alias needed moving out of ai_model; no settings changed.');
  }

  $strandedExpansionModel = $config->get('ai_expansion_model') ?? '';

  $config->set('amazee_model', $strandedModel);
  $config->set('ai_model', ScoltaSettingsForm::DEFAULT_AI_MODEL);
  if ($strandedExpansionModel !== '') {
    $config->set('amazee_expansion_model', $strandedExpansionModel);
    $config->set('ai_expansion_model', '');
  }
  $config->save();

  \Drupal::logger('scolta')->notice(
    'Moved the Amazee.ai gateway model @model out of ai_model into amazee_model (expansion model: @expansion). ai_model is reset to the shipped default @default; set your provider-native model at Administration › Configuration › Search and metadata › Scolta if you use a direct provider key.',
    [
      '@model' => $strandedModel,
      '@expansion' => $strandedExpansionModel !== '' ? $strandedExpansionModel : '(none)',
      '@default' => ScoltaSettingsForm::DEFAULT_AI_MODEL,
    ]
  );

  return t('Moved the Amazee.ai gateway model @model out of ai_model into amazee_model, and reset ai_model to the shipped default @default. Amazee.ai keeps working unchanged. If you switch to a direct Anthropic or OpenAI key, set your own model at Administration › Configuration › Search and metadata › Scolta — @model is an Amazee.ai gateway name and no other provider accepts it.', [
    '@model' => $strandedModel,
    '@default' => ScoltaSettingsForm::DEFAULT_AI_MODEL,
  ]);
}
