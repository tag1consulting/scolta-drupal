<?xml version="1.0" encoding="UTF-8"?>
<!--
  PHPUnit configuration for Drupal functional (BrowserTestBase) tests.

  These tests need a full Drupal installation and a running web server, so
  `composer test` (the fast unit suite) does not run them.

  The `functional` CI job and a local run use the same invocation, from the
  project root of a `ddev poser`-built environment (SIMPLETEST_DB and
  SIMPLETEST_BASE_URL come from .ddev/config.contrib.yaml):

    ddev exec "vendor/bin/phpunit -c phpunit-functional.xml
      --bootstrap web/core/tests/bootstrap.php"

  The bootstrap is given on the command line, not in this file, because it
  differs by layout: phpunit canonicalizes this file's path, so the relative
  form written here resolves from wherever the file really lives. In the
  ddev project that is the project root (web/core/... below); in a consuming
  site with the module at web/modules/contrib/scolta it is three levels
  above web/core/. The bootstrap attribute below serves the consuming-site
  layout; the ddev invocation overrides it.

  (`-c` is phpunit's short form for the configuration option. The long form
  cannot appear in this comment: XML forbids a double hyphen inside one, and
  writing it here is what made this file unparseable until 2026-08-24.)
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd"
         bootstrap="../../../core/tests/bootstrap.php"
         colors="true"
         beStrictAboutTestsThatDoNotTestAnything="true">
  <testsuites>
    <testsuite name="functional">
      <directory>tests/src/Functional</directory>
    </testsuite>
  </testsuites>
  <php>
    <ini name="error_reporting" value="32767"/>
    <ini name="memory_limit" value="512M"/>
    <!-- SIMPLETEST_DB and SIMPLETEST_BASE_URL come from the environment. -->
    <env name="SYMFONY_DEPRECATIONS_HELPER" value="disabled"/>
    <env name="BROWSERTEST_OUTPUT_DIRECTORY" value="/tmp/browsertest_output"/>
  </php>
</phpunit>
