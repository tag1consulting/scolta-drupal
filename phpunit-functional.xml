<?xml version="1.0" encoding="UTF-8"?>
<!--
  PHPUnit configuration for Drupal functional (BrowserTestBase) tests.

  These tests need a full Drupal installation and a running web server, so
  `composer test` (the fast unit suite) does not run them.

  This file is for running them locally. The `functional` GitHub Actions job
  does not read it: that job builds a throwaway Drupal project, exports
  SIMPLETEST_DB, SIMPLETEST_BASE_URL, BROWSERTEST_OUTPUT_DIRECTORY and
  SYMFONY_DEPRECATIONS_HELPER into the environment, and points phpunit
  straight at modules/contrib/scolta/tests/src/Functional/ with core's
  bootstrap. Read .github/workflows/ci.yml for what CI actually runs; the
  settings below reproduce the same environment for a local run.

  From inside a DDEV Drupal environment, with the module installed at
  web/modules/contrib/scolta and SIMPLETEST_DB and SIMPLETEST_BASE_URL set:

    ddev exec vendor/bin/phpunit -c web/modules/contrib/scolta/phpunit-functional.xml

  (`-c` is phpunit's short form for the configuration option. The long form
  cannot appear in this comment: XML forbids a double hyphen inside one, and
  writing it here is what made this file unparseable until 2026-08-24.)

  The bootstrap path is relative to this file's own location in the installed
  Drupal project (web/modules/contrib/scolta/), three levels above web/core/.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd"
         bootstrap="../../../core/tests/bootstrap.php"
         colors="true"
         beStrictAboutTestsThatDoNotTestAnything="true">
  <testsuites>
    <testsuite name="functional">
      <directory>tests/src/Functional</directory>
    </testsuite>
  </testsuites>
  <php>
    <ini name="error_reporting" value="32767"/>
    <ini name="memory_limit" value="512M"/>
    <!-- SIMPLETEST_DB and SIMPLETEST_BASE_URL come from the environment. -->
    <env name="SYMFONY_DEPRECATIONS_HELPER" value="disabled"/>
    <env name="BROWSERTEST_OUTPUT_DIRECTORY" value="/tmp/browsertest_output"/>
  </php>
</phpunit>
